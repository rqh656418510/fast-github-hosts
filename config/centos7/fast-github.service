[Unit]
Description=Update /etc/hosts with HelloGitHub entries
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /usr/local/bin/fast-github-hosts.py
TimeoutStartSec=180
NoNewPrivileges=yes
ProtectHome=yes
StandardOutput=journal
StandardError=journal
